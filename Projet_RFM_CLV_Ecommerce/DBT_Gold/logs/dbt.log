        when UnitPrice < 10  then 'Medium (2-10)'
        else                      'High (>10)'
    end                                             as price_tier
from read_parquet('/content/drive/MyDrive/Projet_RFM_CLV_Ecommerce/Data/silver/online_retail_silver.parquet')
